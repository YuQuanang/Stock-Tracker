# ---------------------------------------------------------------------------
# Folio environment variables.
# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.
# NEVER commit real values.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon or Supabase).
# Leave EMPTY in local development to use the embedded PGlite database
# stored in .data/pglite. REQUIRED in production.
# Supabase: use the "Transaction pooler" connection string (port 6543).
# Neon: use the pooled connection string.
DATABASE_URL=

# Password gate. Generate a hash with:  npm run hash-password
# (The hash uses ":" separators on purpose; "$" would be mangled by .env expansion.)
APP_PASSWORD_HASH=
# Quick local alternative (ignored if APP_PASSWORD_HASH is set). Avoid in production.
APP_PASSWORD=

# Random secret that signs the session cookie, at least 32 characters.
# Generate one with:  openssl rand -base64 48
# Changing it (or the password) signs you out everywhere.
SESSION_SECRET=

# Optional: Finnhub free API key (fallback quotes for US stocks).
FINNHUB_API_KEY=

